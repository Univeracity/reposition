include README.md LICENSE NOTICE AGENTS.md reposition
recursive-include licenses *.txt
recursive-include docs *.md
recursive-include docs/brand *.png *.svg
recursive-include examples *.json *.py
recursive-include integrations *.py *.patch *.md
recursive-include tests *.py
recursive-include scripts *.py
recursive-include benchmarks *.py
recursive-include validation *.json
prune docs/dev_coordination
prune validation/local
prune .agent-state
prune .agent-artifacts
